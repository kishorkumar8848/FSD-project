# CloudGuard Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (fallback to mongodb-memory-server automatically if unavailable)
MONGODB_URI=mongodb://127.0.0.1:27017/cloudguard

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# Authentication Secrets & Expiry
JWT_SECRET=cloudguard_super_secure_jwt_dev_secret_key_98234710
JWT_EXPIRES_IN=24h
COOKIE_SECURE=false

# Demo & Simulation Mode
DEMO_MODE=true
ENABLE_CRON_SCHEDULE=true

# Initial Seed Credentials (for initial admin setup)
SEED_ADMIN_EMAIL=admin@cloudguard.io
SEED_ADMIN_PASSWORD=CloudGuard@2026Admin!
SEED_ANALYST_EMAIL=analyst@cloudguard.io
SEED_ANALYST_PASSWORD=CloudGuard@2026Analyst!
